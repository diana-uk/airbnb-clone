{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "dev:debug",
            "path": "backend",
            "label": "npm: dev:debug",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": [
                    {
                        "regexp": ".*"
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "(ts-node-dev|> backend@|dev:debug)",
                    "endsPattern": "(Debugger listening on ws://|Server running on http://localhost:)"
                }
            }
        },
        {
            "type": "npm",
            "script": "build",
            "path": "backend",
            "label": "npm: build - backend",
            "problemMatcher": [
                "$tsc"
            ]
        }
    ]
}